#!/usr/bin/env bash

configure_base() {
    if [[ $# -ne 4 ]]; then
        echo "Invalid argument count: $#" >&2
        echo "Usage: configure <command> <configuration source> <configuration target>"
        return 1
    fi

    local base_path="$(cd "$(dirname "$0")"; pwd)"
    local cmd="$1"
    local src="$base_path/$2"
    local target="$3"
    local shell="$4"

    if [[ ! -e "$src" ]]; then
        echo "Source file does not exists at $src!" >&2
        return 1
    fi

    if ! command -v "$cmd" >/dev/null; then
        echo "$cmd is not installed. Skipping $cmd configuration."
        return 0
    fi

    if "$shell"; then
        local source_command=". $src"
        local pre_gate="# >>> ========== >>>"
        local post_gate="# <<< ========== <<<"

        if grep -q "$source_command" "$target"; then
            echo "$cmd configuration file at $src is already sourced at $target"
            return 0
        fi

        if ! printf "\n%s\n%s\n%s\n" "$pre_gate" "$source_command" "$post_gate" >> "$target"; then
            echo "Failed to modify $target: ($?)" >&2
            return 1
        fi
    else
        if [[ -e "$target" ]]; then
            echo "There is an existing configuration for $cmd at $target. Skipping."
            return 0
        fi

        if ! ln -s "$src" "$target" >/dev/null; then
            echo "Symlink creation failed: ($?)" >&2
            return 1
        fi
    fi

    echo "Successfully configured $cmd."
    return 0
}

configure_shell() {
    configure_base "$@" true
}

configure() {
    configure_base "$@" false
}

# Tmux
configure tmux tmux/.tmux.conf $HOME/.tmux.conf

# Neovim
configure nvim nvim $HOME/.config/nvim

# Git
configure git git/.gitconfig $HOME/.gitconfig

# Zsh
configure_shell zsh zsh/.zshrc $HOME/.zshrc
